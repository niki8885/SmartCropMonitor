# =============================================================================
# SmartCropMonitor — environment configuration template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# =============================================================================

# --- Deployment / API exposure -----------------------------------------------
# Set ENVIRONMENT=production on prod. In production the interactive API docs
# (Swagger /docs, ReDoc /redoc) and the OpenAPI schema (/openapi.json) are
# hidden so the API surface and DB schema are not publicly browsable.
ENVIRONMENT=development
# Force-enable/disable the docs regardless of ENVIRONMENT (true/false).
# ENABLE_DOCS=false

# --- Security ----------------------------------------------------------------
# Secret used to sign JWT access tokens. Generate a strong random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret

# --- Database ----------------------------------------------------------------
# PostgreSQL + PostGIS connection string.
SQLALCHEMY_DATABASE_URL=postgresql://user:password@localhost:5432/smartcrop

# --- Internal services -------------------------------------------------------
HASKELL_SERVICE_URL=http://localhost:8081/field-stats

# --- Third-party API keys ----------------------------------------------------
# OpenWeatherMap API key (fallback weather provider). Keep this out of source.
WEATHER_API_KEY=
# Outbound webhook for alert delivery (optional).
WEBHOOK_URL=

# --- Email / alerting (optional) ---------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BRIEFING_FROM_EMAIL=
ALERT_EMAIL_ENABLED=true

# --- Storage cleanup (optional) ----------------------------------------------
CLEANUP_RETAIN_LATEST_DATASETS=10
CLEANUP_MIN_FILE_AGE_HOURS=1

# --- Frontend build args (docker-compose) ------------------------------------
VITE_API_URL=http://127.0.0.1:8000
VITE_MAPBOX_TOKEN=

# --- WRF batch containers (docker-compose, optional) -------------------------
COMPOSE_PROJECT_NAME=smartcropmonitor
TOPO_HOST_PATH=/mnt/volume-nbg1-2/topo
